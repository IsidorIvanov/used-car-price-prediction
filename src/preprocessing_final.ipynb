    "def preprocess_data(df):\n",
    "    data = df.copy()\n",
    "    rows_start = len(data)\n",
    "    print(f\"Početni broj redova: {rows_start}\\n\")\n",
    "\n",
    "    # --- 1. DROP NEPOTREBNIH KOLONA ---\n",
    "    cols_to_drop = [\"Unnamed: 0\", \"offer_description\"]\n",
    "    for col in cols_to_drop:\n",
    "        if col in data.columns:\n",
    "            data = data.drop(columns=[col])\n",
    "            print(f\"[Drop] {col}\")\n",
    "\n",
    "    # --- 2. KONVERZIJA U NUMERIČKE TIPOVE ---\n",
    "    # Kolone kao \"10,9 l/100 km\" ili \"- (g/km)\" se čiste i pretvaraju u float\n",
    "    numeric_columns = [\n",
    "        \"year\", \"price_in_euro\", \"power_kw\", \"power_ps\",\n",
    "        \"fuel_consumption_l_100km\", \"fuel_consumption_g_km\", \"mileage_in_km\",\n",
    "    ]\n",
    "    for col in numeric_columns:\n",
    "        if col in data.columns:\n",
    "            data[col] = fix_numeric_column(data[col])\n",
    "    print(f\"[Konverzija] {len(numeric_columns)} kolona -> float\")\n",
    "\n",
    "    # --- 3. ČIŠĆENJE KATEGORIČKIH KOLONA ---\n",
    "    # fuel_type: 136 varijanti -> osnovni tipovi\n",
    "    if \"fuel_type\" in data.columns:\n",
    "        data[\"fuel_type\"] = data[\"fuel_type\"].str.strip().str.lower()\n",
    "        fuel_map = {\n",
    "            \"petrol\": \"petrol\", \"benzin\": \"petrol\", \"gasoline\": \"petrol\",\n",
    "            \"diesel\": \"diesel\",\n",
    "            \"electric\": \"electric\",\n",
    "            \"electric/gasoline\": \"hybrid\", \"electric/diesel\": \"hybrid\", \"hybrid\": \"hybrid\",\n",
    "            \"lpg\": \"lpg\", \"cng\": \"cng\", \"hydrogen\": \"hydrogen\",\n",
    "        }\n",
    "        data[\"fuel_type\"] = data[\"fuel_type\"].map(fuel_map).fillna(\"other\")\n",
    "        print(f\"[fuel_type] Mapirano na {data['fuel_type'].nunique()} kategorija\")\n",
    "\n",
    "    # Normalizacija ostalih kategoričkih (lowercase, strip)\n",
    "    for col in [\"brand\", \"model\", \"color\", \"transmission_type\"]:\n",
    "        if col in data.columns:\n",
    "            data[col] = data[col].str.strip().str.lower()\n",
    "\n",
    "    # transmission: \"unknown\" -> drop, \"semi-automatic\" -> spoji sa \"automatic\"\n",
    "    if \"transmission_type\" in data.columns:\n",
    "        unknown_count = (data[\"transmission_type\"] == \"unknown\").sum()\n",
    "        data = data[data[\"transmission_type\"] != \"unknown\"]\n",
    "        data[\"transmission_type\"] = data[\"transmission_type\"].replace(\n",
    "            \"semi-automatic\", \"automatic\"\n",
    "        )\n",
    "        print(f\"[Transmission] 'unknown' uklonjeno: {unknown_count}, 'semi-automatic' -> 'automatic'\")\n",
    "\n",
    "    # --- 4. FEATURE ENGINEERING ---\n",
    "    # registration_date -> samo mesec (godina je ista kao year, redundantna)\n",
    "    if \"registration_date\" in data.columns:\n",
    "        reg = pd.to_datetime(data[\"registration_date\"], format=\"%m/%Y\", errors=\"coerce\")\n",
    "        data[\"registration_month\"] = reg.dt.month\n",
    "        data = data.drop(columns=[\"registration_date\"])\n",
    "        print(\"[Feature] registration_date -> registration_month\")\n",
    "\n",
    "    # car_age sa validacijom (negativne i >50 su bagovi u podacima)\n",
    "    if \"year\" in data.columns:\n",
    "        data[\"car_age\"] = 2026 - data[\"year\"]\n",
    "        invalid_age = (data[\"car_age\"] < 0) | (data[\"car_age\"] > 50)\n",
    "        print(f\"[car_age] Kreirana | Nevalidnih: {invalid_age.sum()} -> uklonjeno\")\n",
    "        data = data[~invalid_age]\n",
    "\n",
    "    # Nerealna kombinacija: star auto sa gotovo 0 km (greška u podacima)\n",
    "    if \"car_age\" in data.columns and \"mileage_in_km\" in data.columns:\n",
    "        suspicious = (data[\"car_age\"] > 5) & (data[\"mileage_in_km\"] < 500)\n",
    "        print(f\"[Filter] Stariji od 5god sa <500km: {suspicious.sum()} -> uklonjeno\")\n",
    "        data = data[~suspicious]\n",
    "\n",
    "    # power_ps -> popuni power_kw gde fali, pa drop ps (1 kW ≈ 1.36 PS)\n",
    "    if \"power_kw\" in data.columns and \"power_ps\" in data.columns:\n",
    "        mask = data[\"power_kw\"].isna() & data[\"power_ps\"].notna()\n",
    "        data.loc[mask, \"power_kw\"] = data.loc[mask, \"power_ps\"] / 1.36\n",
    "        data = data.drop(columns=[\"power_ps\"])\n",
    "        print(f\"[Feature] power_ps -> popunjeno {mask.sum()} kw vrednosti, ps dropovan\")\n",
    "\n",
    "    # --- 5. OUTLIER FILTRIRANJE ---\n",
    "    # NaN vrednosti PROLAZE filter — biće popunjene medijanom u koraku 7\n",
    "    filters = {\n",
    "        \"price_in_euro\": (500, 300_000),\n",
    "        \"power_kw\":      (20, 600),\n",
    "        \"fuel_consumption_l_100km\": (0.5, 30),\n",
    "        \"mileage_in_km\": (0, 500_000),\n",
    "    }\n",
    "    for col, (low, high) in filters.items():\n",
    "        if col in data.columns:\n",
    "            before = len(data)\n",
    "            data = data[(data[col] >= low) & (data[col] <= high) | data[col].isna()]\n",
    "            removed = before - len(data)\n",
    "            if removed > 0:\n",
    "                print(f\"[Outlier] {col} ({low}-{high}): uklonjeno {removed}\")\n",
    "\n",
    "    # --- 6. DUPLIKATI ---\n",
    "    before = len(data)\n",
    "    data = data.drop_duplicates()\n",
    "    print(f\"[Duplikati] Uklonjeno: {before - len(data)}\")\n",
    "\n",
    "    # --- 7. POPUNJAVANJE NaN ---\n",
    "    # Numeričke: median (robustan na outliere)\n",
    "    # Kategoričke: mode (najčešća vrednost)\n",
    "    for col in data.columns:\n",
    "        missing = data[col].isna().sum()\n",
    "        if missing == 0:\n",
    "            continue\n",
    "        if pd.api.types.is_numeric_dtype(data[col]):\n",
    "            median_val = data[col].median()\n",
    "            data[col] = data[col].fillna(median_val)\n",
    "            print(f\"[FillNA] {col}: {missing} -> median ({median_val:.2f})\")\n",
    "        else:\n",
    "            mode_val = data[col].mode(dropna=True)\n",
    "            fill = mode_val.iloc[0] if not mode_val.empty else \"unknown\"\n",
    "            data[col] = data[col].fillna(fill)\n",
    "            print(f\"[FillNA] {col}: {missing} -> mode ('{fill}')\")\n",
    "\n",
    "    print(f\"Završeno: {rows_start} -> {len(data)} redova\")\n",
    "    print(f\"Uklonjeno: {rows_start - len(data)} ({(rows_start - len(data))/rows_start*100:.1f}%)\")\n",
    "    print(f\"Kolone ({len(data.columns)}): {data.columns.tolist()}\")\n",
    "    print(f\"NaN: {data.isnull().sum().sum()}\")\n",
    "\n",
    "    return data"
